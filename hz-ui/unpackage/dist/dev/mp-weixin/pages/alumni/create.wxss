
.publish-container.data-v-649467a0 {
  min-height: 100vh;
  padding: 20rpx;
  background-color: #f8f9fa;
}

/* 顶部导航 */
.publish-header.data-v-649467a0 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: white;
  border-bottom: 1rpx solid #f0f0f0;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
}
.header-left.data-v-649467a0,
.header-right.data-v-649467a0 {
  display: flex;
  align-items: center;
  color: #333;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
}
.header-title.data-v-649467a0 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 内容区 */
.publish-content.data-v-649467a0 {
  height: calc(100vh - 100rpx);
}
.content-input.data-v-649467a0 {
  min-height: 300rpx;
  width: calc(100vw - 100rpx);
  font-size: 32rpx;
  line-height: 1.6;
  background-color: white;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}
.placeholder.data-v-649467a0 {
  color: #ccc;
}
.word-count.data-v-649467a0 {
  text-align: right;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 40rpx;
}

/* 上传区域 */
.upload-section.data-v-649467a0,
.tag-section.data-v-649467a0 {
  background-color: white;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.section-title.data-v-649467a0 {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 30rpx;
}
.image-list.data-v-649467a0 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item.data-v-649467a0 {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.upload-image.data-v-649467a0 {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}
.image-remove.data-v-649467a0 {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-upload-btn.data-v-649467a0 {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}
.upload-text.data-v-649467a0 {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 标签区域 */
.tag-list.data-v-649467a0 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.tag-item.data-v-649467a0 {
  padding: 12rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}
.tag-item.selected.data-v-649467a0 {
  background-color: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}
.custom-tag-input.data-v-649467a0 {
  background-color: #f8f9fa;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

/* 发布说明 */
.notice.data-v-649467a0 {
  background-color: white;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.notice-title.data-v-649467a0 {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}
.notice-list.data-v-649467a0 {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.notice-list text.data-v-649467a0 {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* 加载遮罩 */
.loading-mask.data-v-649467a0 {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
/* 发布按钮 */
.publish-btn.data-v-649467a0 {
  position: fixed;
  bottom: 40rpx;
  right: 30rpx;
  z-index: 100;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.4);
}
.publish-text.data-v-649467a0 {
  color: white;
  font-size: 28rpx;
  margin-left: 10rpx;
  font-weight: 500;
}
.form-section.data-v-649467a0 {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.section-title.data-v-649467a0 {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.required-mark.data-v-649467a0 {
  color: #f5222d;
  margin-left: 5rpx;
}
.form-input.data-v-649467a0, .form-textarea.data-v-649467a0 {
  width: 100%;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid #eee;
line-height: 1.5; /* 明确设置行高 */
  min-height: 80rpx; /* 设置最小高度 */
  display: block; /* 确保是块级元素 */
}
.placeholder.data-v-649467a0 {
  color: #999;
  font-size: 28rpx;
  line-height: 1.5; /* 与输入框行高一致 */
  vertical-align: middle; /* 垂直居中 */
}
.input-tips.data-v-649467a0 {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

