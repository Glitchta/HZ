
.container.data-v-fdb46f71 {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 顶部Tab */
.tabs-wrap.data-v-fdb46f71 {
  background-color: #fff;
  padding-top: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.tabs-scroll.data-v-fdb46f71 {
  white-space: nowrap;
}
.tabs.data-v-fdb46f71 {
  display: flex;
  padding: 0 20rpx;
}
.tab-item.data-v-fdb46f71 {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  position: relative;
}
.tab-text.data-v-fdb46f71 {
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}
.tab-item.active .tab-text.data-v-fdb46f71 {
  color: #007AFF;
  font-weight: bold;
  font-size: 30rpx;
}
.tab-bar.data-v-fdb46f71 {
  position: absolute;
  bottom: 4rpx;
  width: 40rpx;
  height: 6rpx;
  background-color: #007AFF;
  border-radius: 3rpx;
}

/* 列表滚动区 */
.post-scroll.data-v-fdb46f71 { flex: 1;
}
.post-list.data-v-fdb46f71 { padding: 20rpx;
}

/* 卡片 */
.post-card.data-v-fdb46f71 {
  margin-bottom: 20rpx;
}
.post-inner.data-v-fdb46f71 {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.post-header.data-v-fdb46f71 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.type-tag.data-v-fdb46f71 {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.type-tag-text.data-v-fdb46f71 {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}
.post-time.data-v-fdb46f71 {
  font-size: 24rpx;
  color: #999;
}
.post-title.data-v-fdb46f71 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}
.post-desc.data-v-fdb46f71 {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* 图片 */
.post-images.data-v-fdb46f71 {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.post-image.data-v-fdb46f71 {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}
.image-more.data-v-fdb46f71 {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

/* 底部统计 */
.post-footer.data-v-fdb46f71 {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 40rpx;
}
.footer-item.data-v-fdb46f71 {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.footer-num.data-v-fdb46f71 {
  font-size: 24rpx;
  color: #999;
}

/* 加载/空状态 */
.loading-wrap.data-v-fdb46f71 {
  padding: 40rpx 0;
}
.no-more.data-v-fdb46f71 {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
  font-size: 26rpx;
}
.empty-state.data-v-fdb46f71 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}
.empty-img.data-v-fdb46f71 {
  width: 300rpx;
  height: 300rpx;
  opacity: 0.5;
  margin-bottom: 40rpx;
}
.empty-text.data-v-fdb46f71 {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.empty-sub.data-v-fdb46f71 {
  font-size: 26rpx;
  color: #ccc;
}
