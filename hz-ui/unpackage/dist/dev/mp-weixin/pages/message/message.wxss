
.container.data-v-4c1b26cf { min-height: 100vh; background-color: #f5f5f5; padding: 20rpx;
}

/* 分栏 */
.tab-bar.data-v-4c1b26cf {
  display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; padding: 8rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.tab-item.data-v-4c1b26cf {
  flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: #666; border-radius: 12rpx; transition: all .2s; position: relative; display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.tab-item.active.data-v-4c1b26cf { background: #409EFF; color: #fff; font-weight: 600;
}
.tab-badge.data-v-4c1b26cf {
  background: #ff3b30; color: #fff; min-width: 32rpx; height: 32rpx; border-radius: 16rpx; font-size: 20rpx; display: flex; align-items: center; justify-content: center; padding: 0 6rpx;
}

/* 消息 */
.message-list.data-v-4c1b26cf {}
.message-item.data-v-4c1b26cf {
  display: flex; align-items: center; background-color: #fff; padding: 30rpx; border-radius: 20rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}
.message-left.data-v-4c1b26cf { position: relative; margin-right: 20rpx;
}
.avatar.data-v-4c1b26cf { width: 100rpx; height: 100rpx; border-radius: 50%; background-color: #f0f0f0;
}
.unread-badge.data-v-4c1b26cf {
  position: absolute; top: -10rpx; right: -10rpx; background-color: #ff3b30; color: #fff; min-width: 40rpx; height: 40rpx; border-radius: 20rpx; font-size: 20rpx; display: flex; align-items: center; justify-content: center; padding: 0 10rpx;
}
.message-content.data-v-4c1b26cf { flex: 1; display: flex; flex-direction: column; min-width: 0;
}
.message-header.data-v-4c1b26cf { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15rpx;
}
.user-name.data-v-4c1b26cf { font-size: 30rpx; font-weight: bold; color: #333; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 20rpx;
}
.message-time.data-v-4c1b26cf { font-size: 24rpx; color: #999; flex-shrink: 0;
