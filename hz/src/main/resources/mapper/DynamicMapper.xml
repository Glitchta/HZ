<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.hz.mapper.DynamicMapper">
    <!-- 自定义 ResultMap，手动指定每个字段的映射 -->
    <resultMap id="DynamicResultMap" type="com.study.hz.dto.DynamicDto">
        <id property="id" column="id"/>
        <result property="createUser" column="create_user"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <!-- 关键：为 images 字段指定 JacksonTypeHandler -->
        <result property="images" column="images"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="commentCount" column="comment_count"/>
        <result property="likeCount" column="like_count"/>
        <result property="createTime" column="create_time"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
    </resultMap>

    <select id="selectDynamicList" resultMap="DynamicResultMap">
        select d.id,d.create_user,d.title,d.content,d.images,d.comment_count,d.like_count,d.create_time,u.nickname,u.avatar from dynamic d ,user_info u
        where d.create_user = u.user_id
        limit #{offset},#{size}
    </select>    <select id="selectDynamicById" resultMap="DynamicResultMap" parameterType="java.lang.Long">
        select d.id,d.create_user,d.title,d.content,d.images,d.comment_count,d.like_count,d.create_time,u.nickname,u.avatar from dynamic d, user_info u
        where d.create_user = u.user_id and d.id = #{id}
    </select>

</mapper>