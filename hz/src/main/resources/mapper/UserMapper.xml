<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.hz.mapper.UserMapper">

    <select id="selectByUsername" parameterType="java.lang.String" resultType="com.study.hz.pojo.User">
        select id,username,password,openid from user where username = #{username}
    </select>

    <select id="selectByOpenid" parameterType="java.lang.String" resultType="com.study.hz.pojo.User">
        select id,username,password,openid from user where openid = #{openid}
    </select>

</mapper>